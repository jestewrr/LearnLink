@{
    ViewData["Title"] = "Login - LearnLink";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="/images/LearnLink.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/learnlink.css" asp-append-version="true" />
</head>
<body style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); min-height: 100vh;">
    <!-- Auth Header -->
    <nav class="navbar navbar-expand-lg navbar-dark py-3" style="position: absolute; top: 0; width: 100%; z-index: 1000;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <div style="width: 40px; height: 40px; background: transparent; display: flex; align-items: center; justify-content: center;">
                        <img src="~/images/Learnlink.png" alt="LearnLink" style="height: 100%; width: auto;" />
                </div>
                <span class="fw-bold fs-4"><span>Learn</span><span style="color: var(--ll-accent, #E8B84B);">Link</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")"><i class="bi bi-house-door me-1"></i>Home</a></li>
                    <li class="nav-item ms-lg-3">
                        <a href="@Url.Action("Login", "Home")" class="ll-btn ll-btn-primary">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Register", "Home")" class="btn fw-medium" style="background: var(--ll-accent, #E8B84B); color: #1e293b; padding: 0.625rem 1.25rem;">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Auth Content -->
    <div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; padding-top: 100px; padding-bottom: 40px;">
        <div class="container">
            <div class="row justify-content-center">
                <!-- Login Form -->
                <div class="col-lg-5 col-md-8 col-sm-10">
                    <div class="ll-auth-form-container" style="background: #fff; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
                        <div class="ll-auth-form-card" style="padding: 2.5rem;">
                            <div class="text-center mb-4">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 56px; height: 56px; background: var(--ll-primary-light);">
                                    <i class="bi bi-shield-lock fs-4" style="color: var(--ll-primary);"></i>
                                </div>
                                <h2 class="ll-auth-form-title">Welcome back</h2>
                                <p class="ll-auth-form-subtitle mb-0">Enter your credentials to access your account.</p>
                            </div>

                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success d-flex align-items-center small py-2" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    @TempData["SuccessMessage"]
                                </div>
                            }

                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="alert alert-danger d-flex align-items-center small py-2" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    @TempData["ErrorMessage"]
                                </div>
                            }

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger d-flex align-items-center small py-2" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    @ViewBag.Error
                                </div>
                            }

                            <form asp-action="Login" asp-controller="Home" method="post">
                                <div class="mb-3">
                                    <label class="form-label">Email Address</label>
                                    <div class="ll-auth-input-group">
                                        <i class="bi bi-envelope ll-auth-input-icon"></i>
                                        <input type="email" name="email" id="loginEmail" class="form-control" placeholder="Enter your email" value="@(ViewBag.Email ?? string.Empty)" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <label class="form-label mb-0">Password</label>
                                        <a href="@Url.Action("ForgotPassword", "Home")" class="text-decoration-none small fw-medium" style="color: var(--ll-primary); text-transform: none; letter-spacing: 0;">Forgot password?</a>
                                    </div>
                                    <div class="ll-auth-input-group mt-2">
                                        <i class="bi bi-lock ll-auth-input-icon"></i>
                                        <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter your password" required>
                                        <button type="button" class="ll-auth-password-toggle" onclick="togglePassword('loginPassword', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    @if (ViewBag.AttemptsRemaining != null)
                                    {
                                        var rem = (int)ViewBag.AttemptsRemaining;
                                        if (rem > 0)
                                        {
                                            <div class="small mt-2" style="color:@(rem <= 2 ? "#b91c1c" : "#6b7280")">Attempts remaining before lockout: @rem</div>
                                        }
                                    }
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMe" @(ViewBag.RememberMe == true ? "checked" : "")>
                                    <label class="form-check-label small" for="rememberMe">Remember me for 30 days</label>
                                </div>

                                @* Show reCAPTCHA for login when required *@
                                <button type="submit" id="loginSubmitBtn" class="btn ll-auth-btn-primary w-100 py-2 mb-3">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                                </button>
                            </form>

                            @if (ViewBag.GoogleAuthEnabled == true)
                            {
                            <!-- Google Sign-In Divider -->
                            <div class="ll-auth-divider my-3">
                                <span>or continue with</span>
                            </div>

                            <!-- Google Sign-In -->
                            <form asp-action="GoogleLogin" method="post">
                                <input type="hidden" name="returnUrl" value="@Url.Action("Login", "Home")" />
                                <button type="submit" class="btn ll-auth-btn-google w-100 py-2 mb-3">
                                    <svg class="me-2" width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.0 24.0 0 0 0 0 21.56l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                                    Sign in with Google
                                </button>
                            </form>
                            }

                            <div class="text-center">
                                <span class="text-muted small">Don't have an account?</span>
                                <a href="@Url.Action("Register", "Home")" class="text-decoration-none small fw-semibold" style="color: var(--ll-primary);">Register</a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="failedLoginHelpModal" tabindex="-1" aria-labelledby="failedLoginHelpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="failedLoginHelpModalLabel">Need help signing in?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">We noticed multiple failed sign-in attempts on this account.</p>
                    @if (ViewBag.FailedAttempts != null)
                    {
                        <p class="text-muted small mb-0">Failed attempts: @ViewBag.FailedAttempts</p>
                    }
                    <p class="text-muted small mt-2 mb-0">You can reset your password, or use Google Sign-In if that's what your account currently supports for testing.</p>
                </div>
                <div class="modal-footer">
                    <a href="@Url.Action("ForgotPassword", "Home")" class="btn btn-outline-primary">Forgot Password</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const shouldShowFailedLoginModal = @((ViewBag.ShowForgotPasswordModal == true).ToString().ToLowerInvariant());
            if (!shouldShowFailedLoginModal) {
                return;
            }

            const modalEl = document.getElementById('failedLoginHelpModal');
            if (!modalEl || typeof bootstrap === 'undefined') {
                return;
            }

            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        });

        // Lockout Check Logic
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.getElementById('loginEmail');
            const passwordInput = document.getElementById('loginPassword');
            const submitBtn = document.getElementById('loginSubmitBtn');
            let lockoutTimeout;
            let debounceTimer;

            function checkLockout() {
                const email = emailInput.value.trim();
                if (!email) {
                    unlockFields();
                    return;
                }
                
                fetch('/Home/CheckLockoutStatus?email=' + encodeURIComponent(email))
                    .then(response => response.json())
                    .then(data => {
                        if (data.isLocked) {
                            lockFields();
                            // Check again in 30 seconds to automatically unlock when cooldown expires
                            clearTimeout(lockoutTimeout);
                            lockoutTimeout = setTimeout(checkLockout, 30000);
                        } else {
                            unlockFields();
                        }
                    })
                    .catch(error => {
                        console.error('Error checking lockout status:', error);
                    });
            }

            function lockFields() {
                passwordInput.disabled = true;
                passwordInput.value = '';
                passwordInput.placeholder = 'Account temporarily locked';
                if(submitBtn) submitBtn.disabled = true;
            }

            function unlockFields() {
                if (passwordInput.disabled) {
                    passwordInput.disabled = false;
                    passwordInput.placeholder = 'Enter your password';
                    if(submitBtn) submitBtn.disabled = false;
                }
                clearTimeout(lockoutTimeout);
            }

            if (emailInput) {
                emailInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    // Check if email changed to avoid unnecessary API calls
                    debounceTimer = setTimeout(checkLockout, 400);
                });
                
                // Initial check on load if email is pre-filled
                if (emailInput.value.trim()) {
                    checkLockout();
                }
            }
        });
    </script>
</body>
</html>
