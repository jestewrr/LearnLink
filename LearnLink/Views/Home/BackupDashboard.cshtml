@using LearnLink.Models
@using LearnLink.Services
@{
    ViewData["Title"] = "System Backup & Recovery";
    var records = ViewBag.Records as List<BackupRecord> ?? new List<BackupRecord>();
    var archivedResources = ViewBag.ArchivedResources as List<ArchivedResource> ?? new List<ArchivedResource>();
    var restoreHistory = ViewBag.RestoreHistory as List<RestoreOperation> ?? new List<RestoreOperation>();
    var metrics = ViewBag.Metrics as BackupMetricsDto ?? new BackupMetricsDto();
    
    double totalCapacityGb = 100.0;
    double totalUsedGb = Math.Round(metrics.TotalSizeMb / 1024.0, 2);
    double usagePercent = (totalUsedGb / totalCapacityGb) * 100;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="g1-header mb-0">System Backup & Recovery</h2>
            <p class="text-muted mb-0">Manage system backups, restore points, and archived resources.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#manualBackupModal">
            <i class="bi bi-cloud-arrow-up"></i> Create Backup
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Storage Metrics Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="g1-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="g1-header mb-0"><i class="bi bi-hdd-network"></i> Enterprise Storage Allocation</h5>
                    <span class="badge bg-primary">Total Used: @totalUsedGb GB / @totalCapacityGb GB</span>
                </div>
                <div class="progress mb-3" style="height: 25px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @usagePercent%;" aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100">@Math.Round(usagePercent, 1)% Used</div>
                </div>
                
                <div class="row text-center mt-4">
                    <div class="col-md-2 col-sm-4 border-end">
                        <div class="text-muted small">Database Size</div>
                        <div class="fw-bold text-success fs-5">@Math.Round(metrics.DatabaseSizeMb, 2) MB</div>
                    </div>
                    <div class="col-md-2 col-sm-4 border-end">
                        <div class="text-muted small">User Uploads</div>
                        <div class="fw-bold text-info fs-5">@Math.Round(metrics.UploadsSizeMb, 2) MB</div>
                    </div>
                    <div class="col-md-2 col-sm-4 border-end">
                        <div class="text-muted small">Math Resources</div>
                        <div class="fw-bold fs-5">@metrics.RepositoryCounts.GetValueOrDefault("Math Resources", 0)</div>
                    </div>
                    <div class="col-md-2 col-sm-4 border-end">
                        <div class="text-muted small">Science Resources</div>
                        <div class="fw-bold fs-5">@metrics.RepositoryCounts.GetValueOrDefault("Science Resources", 0)</div>
                    </div>
                    <div class="col-md-2 col-sm-4 border-end">
                        <div class="text-muted small">User Accounts</div>
                        <div class="fw-bold fs-5">@metrics.RepositoryCounts.GetValueOrDefault("User Accounts", 0)</div>
                    </div>
                    <div class="col-md-2 col-sm-4">
                        <div class="text-muted small">Archived Resources</div>
                        <div class="fw-bold fs-5">@metrics.RepositoryCounts.GetValueOrDefault("Archived Resources", 0)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs g1-tabs mb-4" id="backupTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">Overview</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="archives-tab" data-bs-toggle="tab" data-bs-target="#archives" type="button" role="tab">Archive Management</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">Restore History</button>
        </li>
    </ul>

    <div class="tab-content" id="backupTabsContent">
        <!-- Overview Tab -->
        <div class="tab-pane fade show active" id="overview" role="tabpanel">
            <div class="g1-card p-4">
                <h5 class="g1-header mb-3"><i class="bi bi-clock-history"></i> Recent Backups</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date/Time</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Size</th>
                                <th>Details</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!records.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No backups recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var record in records)
                                {
                                    <tr data-backup-id="@record.Id">
                                        <td>
                                            <div class="fw-bold">@record.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                            <div class="small text-muted">@record.CreatedAt.ToLocalTime().ToString("hh:mm tt")</div>
                                        </td>
                                        <td><span class="badge bg-secondary">@record.BackupType</span></td>
                                        <td>
                                            @if (record.Status == "Completed")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Completed</span>
                                            }
                                            else if (record.Status == "Failed")
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Failed</span>
                                            }
                                            else if (record.Status == "In Progress")
                                            {
                                                <div class="progress" style="height: 20px; width: 100px;">
                                                  <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary backup-progress" role="progressbar" style="width: @record.ProgressPercent%;" aria-valuenow="@record.ProgressPercent" aria-valuemin="0" aria-valuemax="100">@record.ProgressPercent%</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass"></i> @record.Status</span>
                                            }
                                        </td>
                                        <td>@(record.SizeDescription ?? "-")</td>
                                        <td>
                                            <div class="small text-truncate" style="max-width: 250px;" title="@record.Notes">
                                                @record.Notes
                                            </div>
                                            <div class="small text-muted">By: @(record.TriggeredByUser?.Email ?? "System")</div>
                                        </td>
                                        <td>
                                            @if (record.Status == "Completed")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#restoreModal_@record.Id">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                </button>

                                                <!-- Restore Confirmation Modal -->
                                                <div class="modal fade" id="restoreModal_@record.Id" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle"></i> Confirm System Restore</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>You are about to restore the system to the backup created on <strong>@record.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong>.</p>
                                                                <p><strong>Warning:</strong> This will overwrite current data. A temporary snapshot will be created before restoration begins.</p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <form asp-action="RestoreBackup" method="post">
                                                                    <input type="hidden" name="id" value="@record.Id" />
                                                                    <button type="submit" class="btn btn-danger">Proceed with Restore</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Archives Tab -->
        <div class="tab-pane fade" id="archives" role="tabpanel">
            <div class="g1-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="g1-header mb-0"><i class="bi bi-archive"></i> Archived Resources</h5>
                    <p class="text-muted small mb-0">Soft-deleted items that can be restored or permanently removed.</p>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Deleted Date</th>
                                <th>Owner</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!archivedResources.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">No archived resources found.</td></tr>
                            }
                            else
                            {
                                foreach (var archive in archivedResources)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@archive.Title</div>
                                            <div class="small text-muted">@archive.FileSize</div>
                                        </td>
                                        <td><span class="badge bg-secondary">@archive.Category</span></td>
                                        <td>@archive.DateArchived.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td>@archive.Owner?.Email</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form asp-action="RestoreArchivedResource" method="post">
                                                    <input type="hidden" name="id" value="@archive.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-bootstrap-reboot"></i> Restore</button>
                                                </form>
                                                <form asp-action="PermanentlyDeleteResource" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this resource? This action cannot be undone.');">
                                                    <input type="hidden" name="id" value="@archive.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Restore History Tab -->
        <div class="tab-pane fade" id="history" role="tabpanel">
            <div class="g1-card p-4">
                <h5 class="g1-header mb-3"><i class="bi bi-clock-history"></i> Restore Operations Timeline</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Restore Type</th>
                                <th>Status</th>
                                <th>Restored By</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!restoreHistory.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">No restore operations have been performed.</td></tr>
                            }
                            else
                            {
                                foreach (var op in restoreHistory)
                                {
                                    <tr>
                                        <td>@op.RestoreDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td><span class="badge bg-info">@op.RestoreType</span></td>
                                        <td><span class="badge bg-success">@op.Status</span></td>
                                        <td>@op.RestoredByUser?.Email</td>
                                        <td>@op.Details</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Manual Backup Modal -->
<div class="modal fade" id="manualBackupModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cloud-arrow-up"></i> Create Dynamic Backup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="TriggerManualBackup" method="post">
                <div class="modal-body">
                    <p class="text-muted">Select the repositories and data components you want to include in this backup snapshot.</p>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Knowledge Repositories</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="Math Resources" id="repoMath" checked>
                                <label class="form-check-label" for="repoMath">Math Resources (@metrics.RepositoryCounts.GetValueOrDefault("Math Resources", 0) items)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="Science Resources" id="repoScience" checked>
                                <label class="form-check-label" for="repoScience">Science Resources (@metrics.RepositoryCounts.GetValueOrDefault("Science Resources", 0) items)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="English Resources" id="repoEnglish" checked>
                                <label class="form-check-label" for="repoEnglish">English Resources (@metrics.RepositoryCounts.GetValueOrDefault("English Resources", 0) items)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>System Data</h6>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="User Accounts" id="sysUsers" checked>
                                <label class="form-check-label" for="sysUsers">User Accounts (@metrics.RepositoryCounts.GetValueOrDefault("User Accounts", 0))</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="Audit Logs" id="sysLogs">
                                <label class="form-check-label" for="sysLogs">Audit Logs (@metrics.RepositoryCounts.GetValueOrDefault("Audit Logs", 0))</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="selectedRepositories" value="User Uploads" id="sysUploads" checked>
                                <label class="form-check-label" for="sysUploads">User Upload Files (~@Math.Round(metrics.UploadsSizeMb, 1) MB)</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Backup Description/Notes (Optional)</label>
                        <textarea class="form-control" name="notes" rows="2" placeholder="E.g., Pre-deployment backup v2.1"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-play-fill"></i> Initiate Background Backup</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Polling for "In Progress" backups
        function pollBackupStatus() {
            if ($('.backup-progress').length === 0) return; // No backups in progress
            
            $.ajax({
                url: '@Url.Action("GetBackupStatus", "Home")',
                type: 'GET',
                success: function(data) {
                    let stillRunning = false;
                    
                    data.forEach(function(backup) {
                        let row = $('tr[data-backup-id="' + backup.id + '"]');
                        if (row.length) {
                            if (backup.status === "In Progress") {
                                stillRunning = true;
                                row.find('.backup-progress').css('width', backup.progress + '%').text(backup.progress + '%');
                            } else {
                                // Status changed, reload page to get updated UI
                                window.location.reload();
                            }
                        }
                    });
                    
                    if (stillRunning) {
                        setTimeout(pollBackupStatus, 3000); // Poll every 3 seconds
                    }
                }
            });
        }
        
        $(document).ready(function() {
            setTimeout(pollBackupStatus, 3000);
        });
    </script>
}
