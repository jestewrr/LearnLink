@{
    ViewData["Title"] = "Verify - LearnLink";
    Layout = null;
    var flow = (ViewBag.PostAuthFlow as string) ?? "Login";
    var heading = string.Equals(flow, "Google", StringComparison.OrdinalIgnoreCase)
        ? "Verify Google Sign-In"
        : string.Equals(flow, "ForgotPassword", StringComparison.OrdinalIgnoreCase)
        ? "Verify password reset"
        : "Verify your sign-in";
    var subtitle = string.Equals(flow, "Google", StringComparison.OrdinalIgnoreCase)
        ? "Complete the reCAPTCHA check to finish signing in with Google."
        : string.Equals(flow, "ForgotPassword", StringComparison.OrdinalIgnoreCase)
        ? "Complete the reCAPTCHA check to send your reset email."
        : "Complete the reCAPTCHA check to finish signing in.";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="/images/LearnLink.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/learnlink.css" asp-append-version="true" />
    <style>
        .verify-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: radial-gradient(circle at top, rgba(59,125,216,.08), transparent 34%), linear-gradient(180deg, #f8fbff, #eef4ff);
            padding: 24px;
        }
        .verify-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
            padding: 40px 34px 32px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="verify-shell">
        <div class="verify-card">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: var(--ll-primary-light);">
                <i class="bi bi-shield-check fs-3" style="color: var(--ll-primary);"></i>
            </div>
            <h2 class="ll-auth-form-title mb-2">@heading</h2>
            <p class="text-muted mb-4">@subtitle</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center small py-2 text-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form id="recaptchaForm" asp-action="PostAuthRecaptcha" asp-controller="Home" method="post">
                <input type="hidden" name="flow" value="@flow" />
                @if (string.Equals(flow, "ForgotPassword", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="email" value="@ViewBag.PostAuthEmail" />
                }
                <div class="mb-3 d-flex justify-content-center">
                    <div class="g-recaptcha" data-sitekey="@ViewBag.ReCaptchaSiteKey" data-callback="onRecaptchaSuccess" data-expired-callback="onRecaptchaExpired"></div>
                </div>
            </form>

            <p class="text-muted small mb-0">After verification, you'll be redirected automatically.</p>
        </div>
    </div>

    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function onRecaptchaSuccess() {
            const form = document.getElementById('recaptchaForm');
            if (form) {
                form.submit();
            }
        }

        function onRecaptchaExpired() {
            // The checkbox can be completed again; no extra action needed.
        }
    </script>
</body>
</html>
