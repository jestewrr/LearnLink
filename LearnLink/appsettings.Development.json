{
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "${Authentication__Google__ClientId}",
      "ClientSecret": "${Authentication__Google__ClientSecret}"
    }
  },
  "Smtp": {
    "Host": "${Smtp__Host}",
    "Port": "${Smtp__Port}",
    "EnableSsl": "${Smtp__EnableSsl}",
    "Username": "${Smtp__Username}",
    "Password": "${Smtp__Password}",
    "FromEmail": "${Smtp__FromEmail}",
    "FromName": "${Smtp__FromName}"
  },
  "ReCaptcha": {
    "SiteKey": "${ReCaptcha__SiteKey}",
    "Secret": "${ReCaptcha__Secret}"
  },
  "Storage": {
    "Provider": "${Storage__Provider}"
  },
  "GoogleDrive": {
    "ServiceAccountJson": "",
    "SharedFolderId": "${GoogleDrive__SharedFolderId}"
  },
  "IdentityMigration": {
    "AutoConfirmTrustedLegacyUsers": false,
    "LegacyCutoffUtc": "2026-04-24T00:00:00Z",
    "ExcludeSuspendedUsers": true,
    "MaxUsersPerRun": 5000,
    "DryRun": false
  }
}
