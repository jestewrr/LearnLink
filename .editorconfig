root = true

# All Files
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# Files
[*.cs]

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = no_change

# Space preferences
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false

# Wrapping preferences
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Code block preferences
csharp_prefer_braces = true:silent
csharp_prefer_simple_using_statement = true:suggestion

# Expression preferences
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_coalescing_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = false:silent
csharp_style_inlined_variable_declaration = true:suggestion

# C# 9+ features
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

# ============================================================================
# SECURITY ANALYSIS RULES - CA (Code Analysis)
# ============================================================================

# SQL Injection Prevention (CA2100)
dotnet_diagnostic.CA2100.severity = error
dotnet_diagnostic.CA2100.description = SQL queries should be parameterized

# Authentication & Authorization
dotnet_diagnostic.CA2109.severity = error
dotnet_diagnostic.CA2109.description = Review visible event handlers

dotnet_diagnostic.CA2119.severity = warning
dotnet_diagnostic.CA2119.description = Seal methods that satisfy private interfaces

# Exception Handling
dotnet_diagnostic.CA2201.severity = error
dotnet_diagnostic.CA2201.description = Do not raise reserved exception types

# XML Security
dotnet_diagnostic.CA3076.severity = error
dotnet_diagnostic.CA3076.description = Insecure XML processing

# Cryptography Security
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5350.description = Do not use weak cryptographic algorithms

dotnet_diagnostic.CA5351.severity = error
dotnet_diagnostic.CA5351.description = Do not use broken or weak cryptographic algorithms

dotnet_diagnostic.CA5373.severity = error
dotnet_diagnostic.CA5373.description = Do not use obsolete key derivation function

dotnet_diagnostic.CA5384.severity = error
dotnet_diagnostic.CA5384.description = Do not use digital signature algorithm (DSA)

dotnet_diagnostic.CA5385.severity = warning
dotnet_diagnostic.CA5385.description = Use Rivest-Shamir-Adleman (RSA) algorithm with sufficient key size

dotnet_diagnostic.CA5386.severity = warning
dotnet_diagnostic.CA5386.description = Avoid hardcoding SecurityProtocolType value

dotnet_diagnostic.CA5387.severity = warning
dotnet_diagnostic.CA5387.description = Do not use weak key derivation function with insufficient iteration count

dotnet_diagnostic.CA5388.severity = warning
dotnet_diagnostic.CA5388.description = Ensure sufficient iteration count when using weak key derivation function

dotnet_diagnostic.CA5390.severity = error
dotnet_diagnostic.CA5390.description = Do not hard-code security protocol version

# Certificate Security
dotnet_diagnostic.CA5359.severity = error
dotnet_diagnostic.CA5359.description = Do not disable certificate validation

dotnet_diagnostic.CA5399.severity = warning
dotnet_diagnostic.CA5399.description = HttpClients should enable certificate revocation list checks

dotnet_diagnostic.CA5400.severity = warning
dotnet_diagnostic.CA5400.description = Ensure HttpClient certificate revocation list check is not disabled

# ASP.NET Core Security
dotnet_diagnostic.CA5391.severity = warning
dotnet_diagnostic.CA5391.description = Use antiforgery tokens in ASP.NET Core MVC controllers

dotnet_diagnostic.CA5396.severity = warning
dotnet_diagnostic.CA5396.description = Set HttpOnly to true for HttpCookie

dotnet_diagnostic.CA5397.severity = warning
dotnet_diagnostic.CA5397.description = Do not use deprecated SSL/TLS versions

# Deserialization Security
dotnet_diagnostic.CA5394.severity = error
dotnet_diagnostic.CA5394.description = Do not use unsafe deserializer

dotnet_diagnostic.CA5395.severity = warning
dotnet_diagnostic.CA5395.description = Miss HttpVerb attribute for action methods

# P/Invoke Security
dotnet_diagnostic.CA5392.severity = warning
dotnet_diagnostic.CA5392.description = Use DefaultDllImportSearchPaths attribute for P/Invokes

dotnet_diagnostic.CA5393.severity = warning
dotnet_diagnostic.CA5393.description = Do not use unsafe DLL import search path value

# Naming Conventions
dotnet_diagnostic.CA1711.severity = warning
dotnet_diagnostic.CA1711.description = Identifier names should not have incorrect suffix

dotnet_diagnostic.CA1712.severity = warning
dotnet_diagnostic.CA1712.description = Do not prefix enum values with type name

# ============================================================================
# PERFORMANCE & BEST PRACTICES
# ============================================================================

dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA1001.description = Types that own disposable fields should be disposable

dotnet_diagnostic.CA1051.severity = warning
dotnet_diagnostic.CA1051.description = Do not declare visible instance fields

dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1502.description = Avoid excessive complexity

dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1505.description = Avoid unmaintainable code

dotnet_diagnostic.CA1507.severity = warning
dotnet_diagnostic.CA1507.description = Use nameof instead of string literals

# .NET Specific Rules

[*.{csproj,vbproj}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
